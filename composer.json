{
    "name": "quillstack/uri",
    "description": "The simple implementation of PSR-7: UriInterface.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "quillstack",
        "php",
        "php8",
        "uri",
        "uri-interface"
    ],
    "homepage": "https://quillstack.org/packages/uri",
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radek@quillstack.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0|^2.0",
        "quillstack/validator-interface": "^0.6"
    },
    "autoload": {
        "psr-4": {
            "Quillstack\\Uri\\": "src/",
            "Quillstack\\Uri\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "quillstack/unit-tests": "^0.9"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    },
    "scripts": {
        "test": "unit-tests",
        "test:coverage": "phpdbg -qrr vendor/bin/unit-tests",
        "stan": "phpstan analyse"
    }
}
